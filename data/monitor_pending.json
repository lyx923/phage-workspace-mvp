      "target_pathogen_species": [
        "铜绿假单胞菌"
      ],
      "program_status": "active",
      "intended_effects": [
        "治疗囊性纤维化（CF）患者慢性铜绿假单胞菌感染"
      ],
      "notes": "噬菌体鸡尾酒药物管线；2023年8月获FDA快速审评通道资格；此前Ⅰb/Ⅱa期试验显示良好安全性和有效性；2023年11月底宣布第二部分试验取得积极结果；今年年初获FDA孤儿药资格认定；Ⅱb期研究数据预计2025年第三季度公布。",
      "_source_url": "https://mp.weixin.qq.com/s?src=11&timestamp=1789546514&ver=6969&signature=hO4MC5DImLQT785Ru7QMtoQ4BmmFrpqU7WClNuw4zbP2jysvNhY2gl5eacVjvhl-BF0MhvX-B8pEQe8-ELdzcO756BigEtwbo1b8o9vyVZ8L9KYcY-BVS*A936xNI0VH&new=1",
      "_source_label": "BiomX",
